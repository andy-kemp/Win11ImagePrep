<Window x:Class="WinImagePrep.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating Win11 Image Prep"
        Width="720" Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/app.ico"
        FontFamily="pack://application:,,,/Fonts/#Inter"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- The same layout as the Win11 Image Prep splash screen: black and copper card, Atlas standing on the
         right with his antenna rising above the card -->
    <Grid x:Name="Root">
        <Border Background="#090909" CornerRadius="14" Margin="16,76,16,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <!-- Soft copper glow behind Atlas -->
                <Ellipse Width="320" Height="270" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-24,-10" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55BD7448" Offset="0"/>
                            <GradientStop Color="#00BD7448" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

        <Grid Margin="36,30,36,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Source="pack://application:,,,/Assets/akc-logo-dark-bg.png" Height="48" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,8,8">
                <TextBlock Text="Updating" Foreground="#B9AFA6" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Win11 Image Prep" Foreground="White" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <!-- AKC green, www.andykemp.com's dark-theme green -->
                <TextBlock x:Name="VersionText" Text="Updater" Foreground="#7FBF63" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusText" Text="Preparing update..." Foreground="#B9AFA6" FontSize="13"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                         Height="6" Margin="0,0,0,12">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="#2A2420" CornerRadius="3">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#BD7448" CornerRadius="3"/>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <Button Grid.Row="3" x:Name="CloseButton" Content="Close" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="CloseButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#BD7448" BorderThickness="1" CornerRadius="7" Padding="18,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#E8CDB8" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2420"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="www.andykemp.com" Foreground="#7FBF63" FontSize="12"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
            </Grid>
        </Border>

        <!-- Atlas, over the card: feet just above the footer, antenna rising above the card's top edge -->
        <Image Source="pack://application:,,,/Assets/atlas.png" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,60,74" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
            <Image.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5"/>
            </Image.Effect>
        </Image>
    </Grid>
</Window>
