<Window x:Class="WinImagePrep.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating Win11 Image Prep"
        Width="680" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/app.ico"
        FontFamily="pack://application:,,,/Fonts/#Inter"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Same black and copper as the Win11 Image Prep splash screen -->
    <Border x:Name="Root" Background="#090909" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="36,28,30,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Source="pack://application:,,,/Assets/akc-logo-dark-bg.png" Height="44" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Updating Win11 Image Prep" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <!-- AKC green, lifted for black -->
                <TextBlock x:Name="VersionText" Text="Updater" Foreground="#7FA873" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusText" Text="Preparing update..." Foreground="#B9AFA6" FontSize="13"
                           Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Image Grid.Column="1" Grid.RowSpan="2" Source="pack://application:,,,/Assets/atlas.png"
                   Height="180" VerticalAlignment="Bottom" Margin="0,-6,0,4"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                         Height="6" Margin="0,0,0,12">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="#2A2420" CornerRadius="3">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#BD7448" CornerRadius="3"/>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <Button Grid.Row="3" x:Name="CloseButton" Content="Close" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="CloseButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#BD7448" BorderThickness="1" CornerRadius="7" Padding="18,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#E8CDB8" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2420"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="www.andykemp.com" Foreground="#7FA873" FontSize="12"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
