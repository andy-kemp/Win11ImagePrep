<Window x:Class="WinImagePrep.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Win11 Image Prep"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- As AKC AppDeploy's About window: a black-and-copper band at the top to match the splash, with the AKC logo,
         the app's icon and name, the version in AKC green and Atlas; then the details in the theme's shared styles -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#090909" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/akc-logo-dark-bg.png" Height="36" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/app-icon.png" Height="32" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="Win11 Image Prep" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Version}" Foreground="#7FBF63" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <Image Grid.Column="1" Source="pack://application:,,,/Assets/atlas.png" Height="120"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="12,-8,0,-22"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,4,22,18">
            <Button Content="Website" Click="OpenWebsite_Click" Margin="0,0,8,0"/>
            <Button Content="Documentation" Click="OpenDocumentation_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <StackPanel Margin="28,18,28,8">
            <TextBlock Style="{StaticResource AkcBody}" FontWeight="SemiBold"
                       Text="Windows 11 install media with your drivers already in it: a USB stick, an ISO or a saved image, ready to deploy."/>

            <TextBlock Text="Developed by" Style="{StaticResource AkcSubheading}"/>
            <TextBlock Style="{StaticResource AkcBody}" Text="Andy Kemp Consulting Ltd"/>

            <TextBlock Text="Links" Style="{StaticResource AkcSubheading}"/>
            <TextBlock Style="{StaticResource AkcBody}">
                <Hyperlink NavigateUri="https://www.andykemp.com" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AkcCopper}">www.andykemp.com</Hyperlink>
                <LineBreak/>
                <Hyperlink NavigateUri="https://docs.andykemp.com/win11-image-prep/" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AkcCopper}">docs.andykemp.com/win11-image-prep</Hyperlink>
                <LineBreak/>
                <Hyperlink NavigateUri="https://downloads.andykemp.com/win11-image-prep/" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AkcCopper}">downloads.andykemp.com/win11-image-prep</Hyperlink>
            </TextBlock>

            <TextBlock Text="Your files" Style="{StaticResource AkcSubheading}"/>
            <TextBlock Style="{StaticResource AkcMutedText}" Text="Settings, logs, saved images and the working files for a build are kept here."/>
            <Border Style="{StaticResource AkcPathBox}" Margin="0,6,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Padding="10,3" Click="OpenFolder_Click"/>
                    <TextBlock Text="{Binding WorkingFolder}" FontFamily="{StaticResource AkcMono}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource AkcMutedText}" Margin="0,18,0,0" TextAlignment="Center">
                © 2026 Andy Kemp Consulting Ltd. Windows is a trademark of Microsoft.<LineBreak/>Win11 Image Prep is not affiliated with Microsoft.
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
