<Window x:Class="WinImagePrep.Dialogs.SavedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create USB from Saved Image" 
        Height="500" 
        Width="650" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Create USB from Saved Image" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#0078D4" 
                   Margin="0,0,0,15"/>

        <!-- Saved Image Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Select Saved Image:" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbSavedImages" 
                      Height="28"
                      SelectionChanged="CmbSavedImages_SelectionChanged"/>
        </StackPanel>

        <!-- Image Label Info -->
        <Border Grid.Row="2" 
                BorderBrush="#0078D4" 
                BorderThickness="1" 
                Background="#F0F0F0" 
                Padding="10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Image Label:" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="lblImageLabel" 
                           Text="No image selected"/>
            </StackPanel>
        </Border>

        <!-- USB Drive Selection -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Select USB Drive:" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="cmbUsbDrives" 
                          Width="400"
                          Height="28"/>
                <Button Content="Refresh" 
                        Width="80" 
                        Height="28" 
                        Margin="10,0,0,0"
                        Click="BtnRefreshUsb_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Operation Log -->
        <GroupBox Grid.Row="4" 
                  Header="Operation Log" 
                  Padding="5" 
                  Margin="0,0,0,15">
            <ListBox x:Name="lstLog"
                     Background="Black"
                     Foreground="Lime"
                     FontWeight="Bold"
                     FontSize="11"
                     FontFamily="Consolas"
                     BorderThickness="0"/>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Create USB" 
                    Width="120" 
                    Height="36" 
                    Margin="0,0,10,0"
                    Background="#0078D4"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="BtnCreateUsb_Click"/>
            <Button Content="Close" 
                    Width="100" 
                    Height="36"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
