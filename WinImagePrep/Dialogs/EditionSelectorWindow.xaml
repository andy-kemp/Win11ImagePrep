<Window x:Class="WinImagePrep.Dialogs.EditionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Windows Editions" 
        Height="450" 
        Width="600" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Select Windows Editions to Process" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#0078D4" 
                   Margin="0,0,0,10"/>

        <!-- Instructions -->
        <TextBlock Grid.Row="1" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,15">
            <Run Text="Select which editions to inject drivers into." FontWeight="Bold"/>
            <LineBreak/>
            <Run Text="Note: Drivers will "/>
            <Run Text="always" FontWeight="Bold"/>
            <Run Text=" be injected into WinPE and Windows Setup."/>
            <LineBreak/>
            <Run Text="Only the selected editions (and their WinRE) will be processed."/>
        </TextBlock>

        <!-- Edition List with Checkboxes -->
        <Border Grid.Row="2" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstEditions" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" 
                                      Margin="0,5,0,5">
                                <CheckBox.Content>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImageName}" 
                                                   FontWeight="Bold" 
                                                   FontSize="13"/>
                                        <TextBlock>
                                            <Run Text="Index: "/>
                                            <Run Text="{Binding ImageIndex, Mode=OneWay}"/>
                                            <Run Text=" | Size: "/>
                                            <Run Text="{Binding ImageSizeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" 
                                                   Foreground="Gray" 
                                                   FontSize="11" 
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Select All" 
                    Width="100" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Click="BtnSelectAll_Click"/>
            <Button Content="Clear Selection" 
                    Width="100" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Click="BtnClearSelection_Click"/>
            <Button Content="OK" 
                    Width="100" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Background="#0078D4"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnOk_Click"/>
            <Button Content="Cancel" 
                    Width="100" 
                    Height="32"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
