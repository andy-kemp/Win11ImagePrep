<Window x:Class="WinImagePrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="940"
        Height="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="940"
        MinHeight="760"
        Background="{StaticResource AkcBg}"
        AllowDrop="True">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Configuration..." Command="{Binding SaveConfigCommand}" ToolTip="Save current settings to file"/>
                <MenuItem Header="_Open Configuration..." Command="{Binding OpenConfigCommand}" ToolTip="Load settings from file"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" ToolTip="Close the application"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}" ToolTip="Check for newer version on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Options..." Command="{Binding OpenOptionsCommand}" ToolTip="Configure application settings">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User Guide" Command="{Binding OpenUserGuideCommand}" ToolTip="Open local user guide">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Online Documentation" Command="{Binding OpenOnlineDocumentationCommand}" ToolTip="View online documentation at docs.andykemp.com">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_GitHub README" Command="{Binding OpenGitHubReadmeCommand}" ToolTip="View project README on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Report Issue" Command="{Binding OpenReportIssueCommand}" ToolTip="Report bugs or request features on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Release _Notes" Command="{Binding OpenReleaseNotesCommand}" ToolTip="View release notes">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" ToolTip="About Win11 Image Prep">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AkcCopper}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Brand header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/akc-logo.png" Height="44"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource AkcBorder}" Margin="18,4,18,4"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Win11 Image Prep" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AkcHeading}"/>
                    <TextBlock Text="Windows 11 install media with your drivers already in it" Foreground="{StaticResource AkcMuted}" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AkcBgSoft}">
        <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- (spare, was title) -->
            <RowDefinition Height="Auto"/>
            <!-- Unified Drop Zone for ISO & Drivers -->
            <RowDefinition Height="Auto"/>
            <!-- Windows Apps Removal -->
            <RowDefinition Height="Auto"/>
            <!-- Unattended Installation -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- USB Selection -->
            <RowDefinition Height="Auto"/>
            <!-- USB Info -->
            <RowDefinition Height="Auto"/>
            <!-- Warning Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Overall Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Current Operation Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Operation Log -->
        </Grid.RowDefinitions>

        <!-- 1. Files -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
        <StackPanel>
            <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="1" Content="Windows ISO and driver packs"/>

            <!-- Drop Zone with Browse Buttons -->
            <Border x:Name="DropZone"
                    BorderBrush="#C9A88F"
                    BorderThickness="1.5"
                    Background="#F7F3EF"
                    CornerRadius="10"
                    Padding="14"
                    AllowDrop="True"
                    MinHeight="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drop Zone Instructions -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,12">
                        <TextBlock Text="Drop a Windows 11 ISO and your driver packs here"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AkcHeading}"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock Text="MSI, ZIP or a folder of drivers. Or use the buttons below."
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AkcMuted}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- ISO File Display -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="10,6" Margin="0,0,0,6"
                            Visibility="{Binding HasIsoPath, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Background="{StaticResource AkcPanelRaised}" CornerRadius="6" Width="40" Height="26" Margin="0,0,10,0">
                                <TextBlock Text="ISO" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AkcCopper}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Command="{Binding ClearIsoCommand}" ToolTip="Remove ISO" Foreground="{StaticResource AkcDanger}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Command="{Binding VerifyIsoCommand}" ToolTip="Verify ISO" Foreground="{StaticResource AkcOk}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                            <TextBlock Text="{Binding SelectedIsoPath}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AkcHeading}"
                                       ToolTip="{Binding SelectedIsoPath}"/>
                        </DockPanel>
                    </Border>

                    <!-- Driver Packs List -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding DriverSources}"
                                  Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Background="{StaticResource AkcPanelRaised}" CornerRadius="6" Width="40" Height="26" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TypeLabel}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AkcCopper}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.RemoveDriverSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove driver pack" Foreground="{StaticResource AkcDanger}">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FullDisplayText}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Foreground="{StaticResource AkcMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding Path}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AkcHeading}"
                                                   ToolTip="{Binding Path}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Browse Buttons -->
                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Command="{Binding BrowseIsoCommand}" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse for ISO..."/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BrowseDriverSourceCommand}" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add driver pack(s)..."/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BrowseDriverFolderCommand}" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add driver folder..."/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="22" Background="{StaticResource AkcBorder}" Margin="8,0"/>
                        <Button Command="{Binding SaveConfigCommand}" Height="34" ToolTip="Save current configuration to file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save config..."/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenConfigCommand}" Height="34" ToolTip="Load configuration from file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Load config..."/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>
        </Border>

        <!-- 2 and 3. Apps and unattended, side by side -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="2" Content="Remove built-in apps"/>
                    <CheckBox Content="Remove Windows apps from the image"
                              IsChecked="{Binding RemoveWindowsApps}"
                              Margin="0,2,0,10"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding RemoveWindowsApps}">
                        <Button Content="Select apps..."
                                Command="{Binding SelectAppsToRemoveCommand}"
                                Margin="0"
                                Height="32"
                                ToolTip="Choose which Windows apps to remove from the image"/>
                        <TextBlock Text="{Binding SelectedAppsCountText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{StaticResource AkcCopper}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AppLoadingStatusText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource AkcMuted}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="3" Content="Unattended or Autopilot setup"/>
                    <CheckBox Content="Enable unattended Windows installation"
                              IsChecked="{Binding EnableUnattendedInstall}"
                              Margin="0,2,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Configure options..."
                                Command="{Binding ConfigureUnattendedCommand}"
                                IsEnabled="{Binding CanConfigureUnattended}"
                                Margin="0"
                                Height="32"
                                ToolTip="Configure unattended installation settings (auto-partition, locale, etc.)"/>
                        <Border Background="{StaticResource AkcWarnBg}" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AkcWarn}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Wipes disk 0" Foreground="{StaticResource AkcWarn}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Build and output -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource AkcBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="4" Content="Build"/>
                <WrapPanel HorizontalAlignment="Left">
                    <Button Command="{Binding InjectDriversCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            Margin="0,0,8,8"
                            ToolTip="Inject drivers into the image, then optionally create a USB (asks for admin rights)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Prepare image with drivers"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Create USB"
                            Command="{Binding CreateUsbCommand}"
                            Height="38"
                            Margin="0,0,8,8"
                            ToolTip="Create USB from previously prepared image"/>
                    <Button Command="{Binding CreateCustomIsoCommand}"
                            Height="38"
                            Margin="0,0,8,8"
                            ToolTip="Create custom bootable ISO for Ventoy, Rufus, or VMs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create custom ISO"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Create USB from ISO"
                            Command="{Binding CreateUsbFromIsoCommand}"
                            Height="38"
                            Margin="0,0,8,8"
                            ToolTip="Create bootable USB directly from ISO without driver injection"/>
                    <Button Content="From saved image"
                            Command="{Binding FromSavedImageCommand}"
                            Height="38"
                            Margin="0,0,8,8"
                            ToolTip="Load a previously saved image"/>
                </WrapPanel>

                <!-- Image Ready Panel (shows after preparation completes) -->
                <Border Background="{StaticResource AkcOkBg}"
                        BorderBrush="#CFE3D1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsImageReady, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AkcOk}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Image ready"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AkcOk}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button Content="Create ISO"
                                Command="{Binding CreateCustomIsoCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="30" Padding="12,4" Margin="0"/>
                        <Button Content="Create USB"
                                Command="{Binding CreateUsbCommand}"
                                Height="30" Padding="12,4"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- USB Selection -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="USB drive"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontWeight="Bold"
                               Foreground="{StaticResource AkcHeading}"/>

                    <DockPanel Grid.Column="1" LastChildFill="True">
                        <Button Content="Repair / cleanup"
                                Command="{Binding RepairCleanupCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Height="32"
                                Style="{StaticResource DangerButton}"/>
                        <Button Command="{Binding RefreshUsbCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Height="32"
                                ToolTip="Look for USB drives again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        <ComboBox ItemsSource="{Binding UsbDrives}"
                                  SelectedItem="{Binding SelectedUsbDrive}"
                                  DisplayMemberPath="DisplayName"
                                  Height="32"
                                  MinWidth="200"/>
                    </DockPanel>
                </Grid>

                <!-- USB Drive Information -->
                <Border Background="{StaticResource AkcBgSoft}"
                        BorderBrush="{StaticResource AkcBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,10,0,0">
                    <TextBlock Text="{Binding UsbInfo}" TextWrapping="Wrap" Foreground="{StaticResource AkcMuted}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Warning Banner -->
        <Border Grid.Row="7"
                BorderBrush="#E9CF8F"
                BorderThickness="1"
                Background="{StaticResource AkcWarnBg}"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AkcWarn}" Margin="0,2,10,0"/>
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="{StaticResource AkcWarn}"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Progress, side by side -->
        <Grid Grid.Row="8" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Overall progress" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OverallProgress, StringFormat={}{0}%}"
                                   Foreground="{StaticResource AkcMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding OverallProgressText}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AkcHeading}"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Current operation" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentOperationText}"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource AkcText}"/>
                    <ProgressBar Value="{Binding CurrentOperationProgress}" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource AkcCopperDark}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Operation Log -->
        <GroupBox Grid.Row="10" Header="Operation log" Margin="0,5,0,0">
            <Border CornerRadius="8"
                    Background="{StaticResource AkcLogBg}"
                    Padding="10,8">
                <ScrollViewer x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Height="200"
                              Padding="0,0,2,2">
                    <ItemsControl ItemsSource="{Binding LogEntries}"
                                  x:Name="LogItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource AkcLogText}"
                                           FontSize="12"
                                           FontFamily="{StaticResource AkcMono}"
                                           Padding="0,1"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </GroupBox>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
