<Window x:Class="WinImagePrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="920"
        Height="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="920"
        MinHeight="1000"
        Background="White"
        AllowDrop="True">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Configuration..." Command="{Binding SaveConfigCommand}" ToolTip="Save current settings to file"/>
                <MenuItem Header="_Open Configuration..." Command="{Binding OpenConfigCommand}" ToolTip="Load settings from file"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" ToolTip="Close the application"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}" ToolTip="Check for newer version on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Options..." Command="{Binding OpenOptionsCommand}" ToolTip="Configure application settings">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User Guide" Command="{Binding OpenUserGuideCommand}" ToolTip="Open local user guide">
                    <MenuItem.Icon>
                        <TextBlock Text="📘" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Online Documentation" Command="{Binding OpenOnlineDocumentationCommand}" ToolTip="View online documentation at docs.andykemp.com">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_GitHub README" Command="{Binding OpenGitHubReadmeCommand}" ToolTip="View project README on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="📖" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Report Issue" Command="{Binding OpenReportIssueCommand}" ToolTip="Report bugs or request features on GitHub">
                    <MenuItem.Icon>
                        <TextBlock Text="🐛" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Release _Notes" Command="{Binding OpenReleaseNotesCommand}" ToolTip="View release notes">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" ToolTip="About WinImagePrep">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Unified Drop Zone for ISO & Drivers -->
            <RowDefinition Height="Auto"/>
            <!-- Windows Apps Removal -->
            <RowDefinition Height="Auto"/>
            <!-- Unattended Installation -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- USB Selection -->
            <RowDefinition Height="Auto"/>
            <!-- USB Info -->
            <RowDefinition Height="Auto"/>
            <!-- Warning Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Overall Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Current Operation Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Operation Log - collapses when not expanded -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Windows Image Preparation Tool" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#0078D4" 
                   Margin="0,0,0,15"/>

        <!-- Unified Drop Zone for ISO and Drivers -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="1. Select Files:" 
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <!-- Drop Zone with Browse Buttons -->
            <Border x:Name="DropZone"
                    BorderBrush="#0078D4"
                    BorderThickness="2"
                    Background="#F8F8F8"
                    CornerRadius="4"
                    Padding="15"
                    AllowDrop="True"
                    MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drop Zone Instructions -->
                    <TextBlock Grid.Row="0"
                               Text="📁 Drag files here or use Browse buttons below"
                               HorizontalAlignment="Center"
                               Foreground="#666"
                               FontStyle="Italic"
                               FontSize="13"
                               Margin="0,5,0,15"/>

                    <!-- ISO File Display -->
                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                Margin="0,0,0,8"
                                Visibility="{Binding HasIsoPath, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ISO:" 
                                   FontWeight="Bold"
                                   Width="60"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedIsoPath}" 
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Width="600"
                                   ToolTip="{Binding SelectedIsoPath}"/>
                        <Button Content="❌" 
                                Command="{Binding ClearIsoCommand}"
                                Width="28" 
                                Height="28"
                                Margin="10,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="Red"
                                FontSize="14"
                                ToolTip="Remove ISO"
                                Cursor="Hand"/>
                        <Button Content="✓" 
                                Command="{Binding VerifyIsoCommand}"
                                Width="28" 
                                Height="28"
                                Margin="5,0,0,0"
                                Background="#0078D4"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="14"
                                ToolTip="Verify ISO"
                                Cursor="Hand"/>
                    </StackPanel>

                    <!-- Driver Packs List -->
                    <ItemsControl Grid.Row="2" 
                                  ItemsSource="{Binding DriverSources}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Drivers:" 
                                               FontWeight="Bold"
                                               Width="60"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Path}" 
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Width="600"
                                               ToolTip="{Binding Path}"/>
                                    <Button Content="❌" 
                                            Command="{Binding DataContext.RemoveDriverSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="28" 
                                            Height="28"
                                            Margin="10,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="Red"
                                            FontSize="14"
                                            ToolTip="Remove driver pack"
                                            Cursor="Hand"/>
                                    <TextBlock Text="{Binding FullDisplayText}" 
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               FontStyle="Italic"
                                               Foreground="#666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Browse Buttons -->
                    <StackPanel Grid.Row="3" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,10,0,5">
                        <Button Content="📁 Browse for ISO..." 
                                Command="{Binding BrowseIsoCommand}"
                                Width="150" 
                                Height="35"
                                Margin="0,0,10,0"
                                FontSize="13"/>
                        <Button Content="📦 Add Driver Pack(s)..." 
                                Command="{Binding BrowseDriverSourceCommand}"
                                Width="170" 
                                Height="35"
                                FontSize="13"/>
                        <Button Content="📁 Add Driver Folder..." 
                                Command="{Binding BrowseDriverFolderCommand}"
                                Width="170" 
                                Height="35"
                                Margin="10,0,0,0"
                                FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Windows Apps Removal Button -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,5,0,10">
            <TextBlock Text="2. Remove Windows Apps (Optional):"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Remove Windows apps from image" 
                          IsChecked="{Binding RemoveWindowsApps}"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"
                          Width="240"/>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding RemoveWindowsApps}">
                    <Button Content="Select Apps to Remove..." 
                            Command="{Binding SelectAppsToRemoveCommand}"
                            Width="180" 
                            Height="28"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="SemiBold"
                            ToolTip="Choose which Windows apps to remove from the image"/>
                    <TextBlock Text="{Binding SelectedAppsCountText}" 
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="#0078D4"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppLoadingStatusText}" 
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="#666666"
                               FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Unattended Installation Section -->
        <StackPanel Grid.Row="3" Margin="0,15,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="3. Unattended Installation"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Enable unattended Windows installation" 
                          IsChecked="{Binding EnableUnattendedInstall}"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"
                          Width="280"/>
                <Button Content="Configure Options..." 
                        Command="{Binding ConfigureUnattendedCommand}"
                        IsEnabled="{Binding CanConfigureUnattended}"
                        Width="150" 
                        Height="28"
                        Background="#0078D4"
                        Foreground="White"
                        FontWeight="SemiBold"
                        ToolTip="Configure unattended installation settings (auto-partition, locale, etc.)"/>
                <TextBlock VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#D2691E" FontWeight="SemiBold">
                    <Run Text="⚠️"/>
                    <Run Text="Will auto-wipe Disk 0"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Main Action Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal" 
                    Margin="0,10,0,10" 
                    HorizontalAlignment="Center">
            <Button Content="Create USB from ISO" 
                    Command="{Binding CreateUsbFromIsoCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="180" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"
                    ToolTip="Create bootable USB directly from ISO without driver injection"/>
            <Button Content="Prepare Image with Drivers" 
                    Command="{Binding InjectDriversCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="220" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"
                    ToolTip="Inject drivers into ISO, then optionally create USB"/>
            <Button Content="Create USB" 
                    Command="{Binding CreateUsbCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="140" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"
                    ToolTip="Create USB from previously prepared image"/>
            <Button Content="From Saved Image" 
                    Command="{Binding FromSavedImageCommand}"
                    Width="160" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"
                    ToolTip="Load a previously saved image"/>
        </StackPanel>

        <!-- USB Selection -->
        <Grid Grid.Row="5" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="4. Select USB Drive:" 
                       VerticalAlignment="Center" 
                       Width="180" 
                       FontWeight="Bold"/>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <Button Content="Repair/Cleanup" 
                        Command="{Binding RepairCleanupCommand}"
                        DockPanel.Dock="Right"
                        Margin="10,0,0,0" 
                        Width="145" 
                        Height="26"
                        Padding="8,3"
                        Style="{StaticResource DangerButton}"/>
                <Button Content="Refresh" 
                        Command="{Binding RefreshUsbCommand}"
                        DockPanel.Dock="Right"
                        Margin="10,0,0,0" 
                        Width="90" 
                        Height="26"/>
                <ComboBox ItemsSource="{Binding UsbDrives}"
                          SelectedItem="{Binding SelectedUsbDrive}"
                          DisplayMemberPath="DisplayName"
                          Height="26"
                          MinWidth="200"
                          Margin="5,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- USB Drive Information -->
        <Border Grid.Row="6"
                BorderBrush="#0078D4" 
                BorderThickness="1" 
                Background="#F0F0F0" 
                Padding="10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="USB Drive Information:" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding UsbInfo}" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Warning Banner -->
        <Border Grid.Row="7"
                BorderBrush="#E81123" 
                BorderThickness="2" 
                Background="#FFF4CE" 
                Padding="5" 
                Margin="0,0,0,10"
                Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WarningMessage}"
                       Foreground="#E81123" 
                       VerticalAlignment="Center" 
                       FontWeight="Bold" 
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Overall Progress -->
        <GroupBox Grid.Row="8" Header="Overall Progress" Padding="10" Margin="0,0,0,5">
            <StackPanel>
                <TextBlock Text="{Binding OverallProgressText}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           Foreground="#0078D4"/>
                <ProgressBar Value="{Binding OverallProgress}" 
                             Height="24" 
                             Minimum="0" 
                             Maximum="100"
                             Foreground="#0078D4"/>
                <TextBlock Text="{Binding OverallProgress, StringFormat={}{0}% Complete}" 
                           HorizontalAlignment="Center" 
                           FontSize="11" 
                           Margin="0,3,0,0"
                           Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Current Operation Progress -->
        <GroupBox Grid.Row="9" Header="Current Operation" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding CurrentOperationText}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           Foreground="#107C10"/>
                <ProgressBar Value="{Binding CurrentOperationProgress}" 
                             Height="20" 
                             Minimum="0" 
                             Maximum="100"
                             Foreground="#107C10"/>
            </StackPanel>
        </GroupBox>

        <!-- Operation Log -->
        <GroupBox Grid.Row="11" 
                  Header="Operation Log" 
                  Padding="5"
                  Margin="0,0,0,0">
            <Border BorderThickness="1"
                    BorderBrush="#0078D4"
                    Background="Black"
                    Padding="0">
                <ScrollViewer x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Height="150"
                              Padding="0,0,2,2">
                    <ItemsControl ItemsSource="{Binding LogEntries}"
                                  x:Name="LogItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="Lime"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Padding="2"
                                           Margin="0"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </GroupBox>
                                                </Grid>
                                                </DockPanel>
                                            </Window>
