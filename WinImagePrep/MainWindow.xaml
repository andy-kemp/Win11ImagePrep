<Window x:Class="WinImagePrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Image Preparation Tool V3" 
        Height="820" 
        Width="920" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Windows 11 Image Preparation Tool" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#0078D4" 
                   Margin="0,0,0,15"/>

        <!-- ISO Selection -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="1. Select Windows ISO:" 
                       VerticalAlignment="Center" 
                       Width="180" 
                       FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedIsoPath}" 
                     Width="420" 
                     IsReadOnly="True" 
                     Margin="5,0,0,0" 
                     Height="26"/>
            <Button Content="Browse..." 
                    Command="{Binding BrowseIsoCommand}"
                    Margin="5,0,0,0" 
                    Width="90" 
                    Height="26"/>
            <Button Content="Verify" 
                    Command="{Binding VerifyIsoCommand}"
                    Margin="5,0,0,0" 
                    Width="90" 
                    Height="26"
                    Background="#0078D4"
                    Foreground="White"/>
        </StackPanel>

        <!-- MSI Selection -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="2. Select Driver MSI:" 
                       VerticalAlignment="Center" 
                       Width="180" 
                       FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedMsiPath}" 
                     Width="420" 
                     IsReadOnly="True" 
                     Margin="5,0,0,0" 
                     Height="26"/>
            <Button Content="Browse..." 
                    Command="{Binding BrowseMsiCommand}"
                    Margin="5,0,0,0" 
                    Width="90" 
                    Height="26"/>
        </StackPanel>

        <!-- Advanced Options -->
        <GroupBox Grid.Row="3" Header="Advanced Options" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Button Content="Select Specific Windows Editions" 
                        Command="{Binding SelectEditionsCommand}"
                        Height="32" 
                        Margin="0,0,0,5"
                        HorizontalAlignment="Left"
                        Width="250"/>
                <TextBlock Text="Note: By default, all editions will be processed" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Main Action Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    Margin="0,10,0,10" 
                    HorizontalAlignment="Center">
            <Button Content="Prepare Image with Drivers" 
                    Command="{Binding InjectDriversCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="220" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"/>
            <Button Content="Create USB" 
                    Command="{Binding CreateUsbCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="140" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"/>
            <Button Content="From Saved Image" 
                    Command="{Binding FromSavedImageCommand}"
                    Width="160" 
                    Height="40" 
                    Margin="5"
                    FontSize="13"/>
        </StackPanel>

        <!-- USB Selection -->
        <Grid Grid.Row="5" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="3. Select USB Drive:" 
                       VerticalAlignment="Center" 
                       Width="180" 
                       FontWeight="Bold"/>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <Button Content="Repair/Cleanup" 
                        Command="{Binding RepairCleanupCommand}"
                        DockPanel.Dock="Right"
                        Margin="10,0,0,0" 
                        Width="145" 
                        Height="26"
                        Padding="8,3"
                        Style="{StaticResource DangerButton}"/>
                <Button Content="Refresh" 
                        Command="{Binding RefreshUsbCommand}"
                        DockPanel.Dock="Right"
                        Margin="10,0,0,0" 
                        Width="90" 
                        Height="26"/>
                <ComboBox ItemsSource="{Binding UsbDrives}"
                          SelectedItem="{Binding SelectedUsbDrive}"
                          DisplayMemberPath="DisplayName"
                          Height="26"
                          MinWidth="200"
                          Margin="5,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- USB Drive Information -->
        <Border Grid.Row="6" 
                BorderBrush="#0078D4" 
                BorderThickness="1" 
                Background="#F0F0F0" 
                Padding="10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="USB Drive Information:" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding UsbInfo}" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Warning Banner -->
        <Border Grid.Row="7" 
                BorderBrush="#E81123" 
                BorderThickness="2" 
                Background="#FFF4CE" 
                Padding="5" 
                Margin="0,0,0,10"
                Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WarningMessage}"
                       Foreground="#E81123" 
                       VerticalAlignment="Center" 
                       FontWeight="Bold" 
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Operation Log -->
        <GroupBox Grid.Row="8" Header="Operation Log" Padding="5">
            <ListBox ItemsSource="{Binding LogEntries}"
                     Background="Black"
                     Foreground="Lime"
                     FontWeight="Bold"
                     FontSize="12"
                     FontFamily="Consolas"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="Lime"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <EventSetter Event="Loaded" Handler="LogItem_Loaded"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
