<Window x:Class="WinImagePrep.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WinImagePrep.Converters"
        mc:Ignorable="d"
        Title="Options - Windows Image Preparation Tool"
        Width="700" 
        Height="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="700"
        MinHeight="650"
        Background="White"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Converters -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,5,0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Read-Only Label Style -->
        <Style x:Key="ReadOnlyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Path Display Style -->
        <Style x:Key="PathDisplayStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Application Settings" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Configure storage locations and application behavior" 
                       FontSize="12" 
                       Foreground="#7F8C8D"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Storage Locations Section -->
                <TextBlock Text="Storage Locations" Style="{StaticResource SectionTitleStyle}"/>
                <Border Background="#F8F9FA" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Working Folder" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Main directory for all ISO processing, driver injection, and temporary files" 
                                   FontSize="11" 
                                   Foreground="#6C757D" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="8,6"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1" 
                                    Content="Browse..."
                                    Command="{Binding BrowseCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="15,6"/>
                        </Grid>

                        <!-- Derived Paths (Read-Only) -->
                        <TextBlock Text="DERIVED PATHS (automatically computed from Working Folder)" 
                                   Style="{StaticResource ReadOnlyLabelStyle}"
                                   Margin="0,15,0,8"/>
                        <Separator Margin="0,0,0,10"/>

                        <TextBlock Text="ISO Extraction:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding IsoExtractionPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>

                        <TextBlock Text="Drivers:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding DriversPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>

                        <TextBlock Text="Mount:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding MountPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>

                        <TextBlock Text="Temp:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding TempPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>

                        <TextBlock Text="Saved Images:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding SavedImagesPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>

                        <TextBlock Text="Logs:" Style="{StaticResource ReadOnlyLabelStyle}"/>
                        <TextBox Text="{Binding LogsPath, Mode=OneWay}" Style="{StaticResource PathDisplayStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Application Settings Section -->
                <TextBlock Text="Application Settings" Style="{StaticResource SectionTitleStyle}"/>
                <Border Background="#F8F9FA" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding DeleteTempFilesOnExit}"
                                  Content="Delete temporary files on exit"
                                  FontSize="13"
                                  Margin="0,0,0,10"/>

                        <CheckBox IsChecked="{Binding AutoCleanupMounts}"
                                  Content="Automatically cleanup mounted images on errors or exit"
                                  FontSize="13"
                                  Margin="0,0,0,10"/>

                        <CheckBox IsChecked="{Binding CheckForUpdates}"
                                  Content="Check for application updates on startup"
                                  FontSize="13"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Log Level" Style="{StaticResource LabelStyle}" Margin="0,10,0,5"/>
                        <ComboBox SelectedItem="{Binding LogLevel}"
                                  FontSize="12"
                                  Padding="8,6">
                            <ComboBoxItem Content="Minimal"/>
                            <ComboBoxItem Content="Information"/>
                            <ComboBoxItem Content="Verbose"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Validation Message -->
        <Border Grid.Row="2" 
                Margin="0,10,0,15"
                Padding="12"
                CornerRadius="5"
                Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D1ECF1"/>
                    <Setter Property="BorderBrush" Value="#BEE5EB"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValidationError}" Value="True">
                            <Setter Property="Background" Value="#F8D7DA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValidationSuccess}" Value="True">
                            <Setter Property="Background" Value="#D4EDDA"/>
                            <Setter Property="BorderBrush" Value="#C3E6CB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding ValidationMessage}" 
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#0C5460"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValidationError}" Value="True">
                                <Setter Property="Foreground" Value="#721C24"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsValidationSuccess}" Value="True">
                                <Setter Property="Foreground" Value="#155724"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Reset to Defaults"
                    Command="{Binding ResetToDefaultsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    ToolTip="Reset settings to default values (can be undone by clicking Cancel)"/>

            <Button Grid.Column="1"
                    Content="Reset Everything..."
                    Command="{Binding ResetEverythingCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    ToolTip="Delete all settings and trigger first-run wizard on next start (for troubleshooting)"/>

            <Button Grid.Column="3"
                    Content="Validate"
                    Command="{Binding ValidateCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding IsValidating, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="4"
                    Content="Save"
                    Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding IsValidating, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="5"
                    Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
