<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net8.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<Nullable>enable</Nullable>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>app.ico</ApplicationIcon>
	<AssemblyName>WinImagePrep</AssemblyName>
	<RootNamespace>WinImagePrep</RootNamespace>
		<Version>5.8.7</Version>
		<AssemblyVersion>5.8.7.0</AssemblyVersion>
		<FileVersion>5.8.7.0</FileVersion>
	<Authors>Andy Kemp Consulting Ltd</Authors>
	<Company>Andy Kemp Consulting Ltd</Company>
	<Product>WinImagePrep</Product>
	<Description>Create customized Windows 11 installation media with integrated drivers</Description>
	<Copyright>Copyright © 2025 Andy Kemp Consulting Ltd</Copyright>

	<!-- Standalone EXE Publishing -->
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishTrimmed>false</PublishTrimmed>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<DebugType>embedded</DebugType>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
	<PackageReference Include="System.Management" Version="8.0.0" />
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="app.ico" />
  </ItemGroup>

  <!-- Include documentation files in publish output -->
  <ItemGroup>
	<None Include="..\docs\UserGuide.html" Link="docs\UserGuide.html">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<None Include="..\docs\ReleaseNotes.txt" Link="docs\ReleaseNotes.txt">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<None Include="..\docs\LICENSE.txt" Link="docs\LICENSE.txt">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>
