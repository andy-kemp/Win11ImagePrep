<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net8.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<Nullable>enable</Nullable>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>app.ico</ApplicationIcon>
	<AssemblyName>WinImagePrep4-3</AssemblyName>
	<RootNamespace>WinImagePrep</RootNamespace>
	<Version>4.0.4</Version>
	<Authors>WinImagePrep</Authors>
	<Company>WinImagePrep</Company>
	<Product>Windows Image Preparation Tool V4</Product>
	<Description>Windows ISO preparation tool with driver injection and app removal for Surface and other devices</Description>
	<Copyright>Copyright © 2024</Copyright>
  </PropertyGroup>

  <!-- Self-contained single-file publish configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Standalone'">
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishTrimmed>false</PublishTrimmed>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<DebugType>embedded</DebugType>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
	<PackageReference Include="System.Management" Version="8.0.0" />
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="app.ico" />
  </ItemGroup>

</Project>
