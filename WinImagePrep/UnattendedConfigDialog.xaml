<Window x:Class="WinImagePrep.UnattendedConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Unattended Installation"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <DockPanel Margin="20">
        <!-- Warning Banner -->
        <Border DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#FFA500" BorderThickness="1" Padding="10" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"/>
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#D2691E">
                    <Run Text="WARNING: Unattended install will automatically wipe all partitions on Disk 0!"/><LineBreak/>
                    <Run Text="Only use this on devices where you want a completely fresh Windows installation." FontWeight="Normal"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Buttons at bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <!-- Configuration Form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Windows Edition -->
                <TextBlock Text="Windows Edition" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="EditionComboBox" Height="30" Margin="0,0,0,15" IsEditable="True">
                    <ComboBoxItem Content="(Auto-detect / User will select)" IsSelected="True"/>
                    <ComboBoxItem Content="Windows 11 Pro"/>
                    <ComboBoxItem Content="Windows 11 Enterprise"/>
                    <ComboBoxItem Content="Windows 11 Home"/>
                    <ComboBoxItem Content="Windows 11 Education"/>
                </ComboBox>
                <TextBlock Text="Leave as auto-detect if your ISO contains multiple editions" Foreground="Gray" FontSize="11" Margin="0,-10,0,15"/>

                <!-- Locale Settings -->
                <TextBlock Text="Language &amp; Region" FontWeight="SemiBold" Margin="0,10,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="UI Language" Margin="0,0,0,5"/>
                        <ComboBox x:Name="UILanguageComboBox" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time Zone" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TimeZoneComboBox" Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- User Account -->
                <TextBlock Text="Local Administrator Account" FontWeight="SemiBold" Margin="0,20,0,10"/>

                <TextBlock Text="Username" Margin="0,0,0,5"/>
                <TextBox x:Name="AdminUsernameTextBox" Height="30" Margin="0,0,0,15"/>

                <TextBlock Text="Password (optional - leave blank to set during install)" Margin="0,0,0,5"/>
                <PasswordBox x:Name="AdminPasswordBox" Height="30" Margin="0,0,0,15"/>

                <!-- Computer Name -->
                <TextBlock Text="Computer Name (optional)" Margin="0,10,0,5"/>
                <TextBox x:Name="ComputerNameTextBox" Height="30" Margin="0,0,0,5"/>
                <TextBlock Text="Leave blank to auto-generate" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>

                <!-- Disk Configuration -->
                <TextBlock Text="Disk Configuration" FontWeight="SemiBold" Margin="0,10,0,10"/>
                <CheckBox x:Name="AutoPartitionCheckBox" Content="Automatically partition and format Disk 0" IsChecked="True" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="Red" FontSize="11" Margin="20,0,0,10">
                    ⚠️ This will ERASE ALL DATA on the primary disk (usually Disk 0)
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                    <TextBlock Text="Target Disk ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="DiskIdTextBox" Width="50" Height="30" Text="0" VerticalAlignment="Center"/>
                    <TextBlock Text="(Usually 0 for primary disk)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="11"/>
                </StackPanel>

                <!-- OOBE Settings -->
                <TextBlock Text="Setup Experience" FontWeight="SemiBold" Margin="0,10,0,10"/>
                <CheckBox x:Name="HideEULACheckBox" Content="Automatically accept license agreement" IsChecked="True" Margin="0,0,0,5"/>
                <CheckBox x:Name="HideWirelessCheckBox" Content="Skip wireless network setup" IsChecked="False" Margin="0,0,0,5"/>
                <CheckBox x:Name="SkipOOBECheckBox" Content="Skip Out-of-Box Experience screens" IsChecked="False" Margin="0,0,0,15"/>

                <TextBlock TextWrapping="Wrap" Foreground="#0078D4" FontSize="11" Margin="0,0,0,10" FontWeight="SemiBold">
                    ℹ️ For Autopilot devices: Leave OOBE and wireless setup enabled so Autopilot enrollment can run.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
