<Window x:Class="WinImagePrep.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Image Prep"
        Width="700" Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True">
    <!-- The Andy Kemp black and copper splash, as on the AKC Audit collector; its own colours, not the app theme. -->
    <Border x:Name="SplashRoot" Background="#090909" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="36,30,30,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Source="pack://application:,,,/Assets/akc-logo-dark-bg.png" Height="52" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Win11 Image Prep" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <!-- AKC green (#42683A), lifted so it reads on black -->
                <TextBlock x:Name="txtVersion" Text="Version" Foreground="#7FA873" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="Windows 11 install media with your drivers already in it." Foreground="#B9AFA6" FontSize="13"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Atlas, the Andy Kemp Consulting robot -->
            <Image Grid.Column="1" Grid.RowSpan="2" Source="pack://application:,,,/Assets/atlas.png"
                   Height="230" VerticalAlignment="Bottom" Margin="0,-10,0,6"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" IsIndeterminate="True" Height="4" Foreground="#BD7448" Background="#2A2420"
                         BorderThickness="0" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtStatus" Grid.Row="3" Text="Starting…" Foreground="#B9AFA6" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="www.andykemp.com" Foreground="#7FA873" FontSize="12"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
