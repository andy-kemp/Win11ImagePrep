<Window x:Class="WinImagePrep.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Image Prep"
        Height="400" 
        Width="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="White" 
            BorderBrush="#8A4E2E" 
            BorderThickness="2"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                            ShadowDepth="0" 
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Logo and Title -->
            <StackPanel Grid.Row="0" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Margin="40">

                <!-- Logo Image -->
                <Image Source="pack://application:,,,/Assets/akc-logo.png"
                       Width="300"
                       Margin="0,0,0,24"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Title -->
                <TextBlock Text="Win11 Image Prep" 
                          FontSize="28" 
                          FontWeight="Bold"
                          Foreground="#8A4E2E"
                          TextAlignment="Center"
                          Margin="0,0,0,10"/>

                <!-- Version -->
                <TextBlock x:Name="txtVersion"
                          Text="Version 4.0.4" 
                          FontSize="16" 
                          Foreground="#625850"
                          TextAlignment="Center"
                          Margin="0,0,0,5"/>

                <!-- Subtitle -->
                <TextBlock Text="Driver injection + Windows app removal" 
                          FontSize="13" 
                          Foreground="#8A7F77"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          MaxWidth="550"
                          Margin="20,10,20,0"/>
            </StackPanel>

            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" Margin="40,0,40,20">
                <ProgressBar Height="6" 
                            IsIndeterminate="True"
                            Foreground="#8A4E2E"
                            Background="#E5D9CE"
                            BorderThickness="0"/>
            </StackPanel>

            <!-- Status Text -->
            <TextBlock x:Name="txtStatus"
                      Grid.Row="2"
                      Text="Initializing application..." 
                      FontSize="12" 
                      Foreground="#625850"
                      TextAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="20"/>
        </Grid>
    </Border>
</Window>
